# Salin ke .env lalu isi (atau set di dashboard hosting). Semua opsional.
PORT=3000
# Folder database SQLite. WAJIB diarahkan ke disk/volume permanen di hosting.
DATA_DIR=./data
# Alamat publik situs (dipakai untuk QR di menu Akun > Bagikan aplikasi)
PUBLIC_URL=https://jagojek.contoh.com
# Saldo demo yang diberikan ke akun baru (rupiah)
SIGNUP_BONUS=100000
# Aktifkan jika di belakang proxy/HTTPS hosting (Render, Railway, Nginx, Cloudflare)
TRUST_PROXY=1
# Batas pendaftaran per IP per jam & login per IP per 10 menit
REG_LIMIT=40
LOGIN_LIMIT=100
